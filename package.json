{
  "name": "stripe-global-payments-platform",
  "version": "0.1.0",
  "description": "Multi-tenant payment orchestration platform for global multinational businesses",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/seed-db.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "stripe:trigger": "stripe trigger payment_intent.succeeded",
    "vercel:env": "vercel env pull .env.local"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^2.7.1",
    "@stripe/stripe-js": "^3.5.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^14.16.0",
    "postgres": "^3.4.4",
    "bullmq": "^5.8.0",
    "redis": "^4.6.13",
    "dotenv": "^16.3.1",
    "sentry-nextjs": "^7.99.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "vercel": "^33.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
