    "@types/react-dom": "^19.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
