# Stripe API Keys
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stripe_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stripe_platform
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Stripe Global Payments Platform

# Vercel Deployment
VERCEL_ENV=development
VERCEL_URL=localhost:3000

# Monitoring & Error Tracking
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe Dashboard Integration (Optional)
STRIPE_DASHBOARD_ID=
STRIPE_ACCOUNT_ID=

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# JWT & Security
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_FRAUD_DETECTION=true
ENABLE_PAYOUT_ACCELERATION=false
ENABLE_MULTI_CURRENCY=true
